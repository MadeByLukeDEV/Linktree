// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// modules/auth — BetterAuth-required tables. Regenerate with:
//   pnpm dlx auth@1.7.5 generate --config src/modules/auth/server.ts -y
// Do not hand-edit these four models; change the BetterAuth config instead.
//
// EXCEPTION: Verification.value has a hand-added @db.Text. The generator
// doesn't know this table also stores the passkey plugin's WebAuthn
// registration/authentication ceremony JSON (challenge + user data), which
// exceeds MySQL's default VARCHAR(191) and fails with a Prisma P2000
// "value too long" error at runtime, not at schema-generation time -- the
// generator has no way to see that from the plugin config alone. If
// regenerating this block ever drops the @db.Text, re-add it.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  passkeys Passkey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// modules/profile — owner display name/bio/avatar. Single-owner app: no
// public signup, so this is effectively a singleton row, not user-scoped.
// ---------------------------------------------------------------------------

model Profile {
  id          String   @id @default(cuid())
  displayName String
  bio         String?  @db.Text
  avatarUrl   String?  @db.VarChar(2048)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profile")
}

// ---------------------------------------------------------------------------
// modules/social-links — core module. A single entry can be shown on the
// public profile (showOnProfile), exposed as a subdomain forward
// (subdomain), or both. modules/redirects reads `subdomain` read-only via
// this module's public service, never directly.
//
// LinkGroup lets links be organized into named sections (e.g. "Partners",
// "Merch") on both the dashboard and the public page. A link's `order` is
// scoped to its bucket (its group, or the ungrouped bucket when groupId is
// null) rather than being one global sequence -- see repository.ts. Deleting
// a group sets its links' groupId back to null (SetNull) rather than
// deleting them; they fall back into the ungrouped bucket.
// ---------------------------------------------------------------------------

model LinkGroup {
  id        String       @id @default(cuid())
  label     String
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  links     SocialLink[]

  @@map("link_group")
}

model SocialLink {
  id            String     @id @default(cuid())
  platform      String
  label         String
  url           String     @db.VarChar(2048)
  icon          String?    @db.VarChar(2048)
  order         Int        @default(0)
  showOnProfile Boolean    @default(true)
  subdomain     String?    @unique
  groupId       String?
  group         LinkGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([groupId])
  @@map("social_link")
}

// modules/auth (cont'd) — the schema generator appends new auth-plugin
// tables here rather than sorting them into the section above; Passkey
// belongs to modules/auth same as User/Session/Account/Verification.
model Passkey {
  id           String    @id
  name         String?   @db.Text
  publicKey    String    @db.Text
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @db.Text
  counter      Int
  deviceType   String    @db.Text
  backedUp     Boolean
  transports   String?   @db.Text
  createdAt    DateTime?
  aaguid       String?   @db.Text

  @@index([userId(length: 191)])
  @@index([credentialID(length: 191)])
  @@map("passkey")
}
