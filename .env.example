# Database (MariaDB, via Prisma's mysql provider — URL-encode special
# characters like + and = in the password)
DATABASE_URL="mysql://user:password@host:3306/dbname"

# Redis (shared cache: subdomain redirects, YouTube API responses)
REDIS_URL="redis://user:password@host:6379"

# Central auth service (auth.aboutselphy.com -- Discord login). Sessions are
# validated by reading its Postgres tables directly, so these must match the
# auth service's own config. In dev, run the auth service on another
# localhost port (cookies aren't port-scoped, so the session is shared) and
# add this app's origin (e.g. http://localhost:3001) to its TRUSTED_ORIGINS.
AUTH_URL="http://localhost:3000"
# Read access to the auth service's session + user tables is enough.
AUTH_DATABASE_URL="postgres://user:password@host:5432/aboutselphy"
AUTH_DATABASE_SCHEMA="auth"
# Same value as the auth service's BETTER_AUTH_SECRET (verifies the cookie).
BETTER_AUTH_SECRET="same-secret-as-the-auth-service"
AUTH_COOKIE_PREFIX="better-auth"

# YouTube Data API v3 (optional — latest video/short card is skipped if unset)
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# Twitch EventSub (optional — live badge on the Twitch link is skipped if
# unset). CLIENT_ID/CLIENT_SECRET are only needed to run
# `pnpm register-twitch-webhook`/`scripts/list-twitch-subscriptions.ts`, not
# by the running app itself. WEBHOOK_SECRET is generated by you (any long
# random string) and used both when registering the subscription and to
# verify incoming webhook signatures.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_BROADCASTER_LOGIN=""
TWITCH_WEBHOOK_SECRET=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Root domain used to detect subdomain forwards in src/proxy.ts (e.g. aboutselphy.com)
NEXT_PUBLIC_ROOT_DOMAIN="aboutselphy.com"
