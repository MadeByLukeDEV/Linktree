# Database (MariaDB, via Prisma's mysql provider — URL-encode special
# characters like + and = in the password)
DATABASE_URL="mysql://user:password@host:3306/dbname"

# Redis (shared cache: subdomain redirects, YouTube API responses)
REDIS_URL="redis://user:password@host:6379"

# BetterAuth
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
# WebAuthn relying party ID for passkeys. Leave unset in dev (defaults to
# "localhost"); set to the production domain once deployed, e.g. aboutselphy.com
PASSKEY_RP_ID=""

# YouTube Data API v3 (optional — latest video/short card is skipped if unset)
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# Twitch EventSub (optional — live badge on the Twitch link is skipped if
# unset). CLIENT_ID/CLIENT_SECRET are only needed to run
# `pnpm register-twitch-webhook`/`scripts/list-twitch-subscriptions.ts`, not
# by the running app itself. WEBHOOK_SECRET is generated by you (any long
# random string) and used both when registering the subscription and to
# verify incoming webhook signatures.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_BROADCASTER_LOGIN=""
TWITCH_WEBHOOK_SECRET=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Root domain used to detect subdomain forwards in src/proxy.ts (e.g. aboutselphy.com)
NEXT_PUBLIC_ROOT_DOMAIN="aboutselphy.com"
